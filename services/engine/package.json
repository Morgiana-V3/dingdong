{
  "name": "dingdong-engine",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    "./sdk": "./sdk/index.ts"
  },
  "description": "Cordis-based pluggable content engine for Dingdong self-hosted inbox",
  "scripts": {
    "postinstall": "node scripts/link-sdk.ts",
    "start": "node src/server.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "plugin:create": "node scripts/create-plugin.ts",
    "plugin:test": "node scripts/test-plugin.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@cordisjs/core": "3.18.1",
    "linkedom": "0.18.12",
    "markdown-it": "14.3.3",
    "sharp": "0.35.5",
    "undici": "8.12.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
