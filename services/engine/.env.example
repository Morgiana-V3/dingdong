# 与 services/relay/.env 保持一致
DINGDONG_SEND_TOKEN=替换为与中转服务一致的发送密钥
DINGDONG_READ_TOKEN=替换为与中转服务一致的接收密钥
RELAY_INTERNAL_URL=http://127.0.0.1:18080

# 引擎监听端口（默认仅监听本机回环，通过 Nginx 反向代理暴露 /v1/engine/）
ENGINE_PORT=18890

# 可选：自定义插件目录与出站代理
# PLUGINS_DIR=/app/plugins
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
